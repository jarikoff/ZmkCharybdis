#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "macros.dtsi"

// / {
//     chosen { zmk,matrix_transform = &default_transform; };
// };

/ {
    /* input config for mouse move mode */

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <0 3>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;

        // bindings = <&ib_toggle_layer 7>;
    };

    /* input config for snipe mode */

    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <2>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
    };

    /* input config for mouse scroll mode */

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <1>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_MISC>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        scale-multiplier = <1>;
        scale-divisor = <4>;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    /* define a resolution down scaler only for INPUT_REL_WHEEL */

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    /* adjust cooldown waiting period for mouse key layer after activated */

    ib_toggle_layer: ib_toggle_layer {
        compatible = "zmk,input-behavior-tog-layer";
        #binding-cells = <1>;
        time-to-live-ms = <750>;
    };

    #define DEF 0
#define MOD 1
#define SYM 2
#define MEDIA 3

    conditional_layers {
        compatible = "zmk,conditional-layers";
        media_layer {
            // Hold both thumb layer keys (MO SYM + MO MOD) to reach MEDIA.
            if-layers = <MOD SYM>;
            then-layer = <MEDIA>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            bindings = <
&kp ESC     &kp NUMBER_1  &kp N2  &kp N3     &kp N4     &kp N5                                           &kp N6     &kp N7                     &kp N8     &kp N9   &kp N0     &kp TILDE
&kp TAB     &kp Q         &kp W   &kp E      &kp R      &kp T                                            &kp Y      &kp U                      &kp I      &kp O    &kp P      &kp PLUS
&kp LSHIFT  &kp A         &kp S   &kp D      &kp F      &kp G                                            &kp H      &kp J                      &kp K      &kp L    &kp SEMI   &kp APOS
&kp LCTRL   &kp Z         &kp X   &kp C      &kp V      &kp B                                            &kp N      &kp M                      &kp COMMA  &kp DOT  &kp SLASH  &kp RIGHT_BRACKET
                                  &mkp RCLK  &mo MOD  &kp SPACE    &kp ENTER  &mo SYM
                                             &kp LGUI  &mkp LCLK    &kp BSPC
            >;
        };

        MOD {
            bindings = <
&kp F1       &kp F2   &kp F3        &kp F4    &kp F5         &kp F6       &kp F7     &kp F8    &kp F9    &kp F10   &kp F11  &kp F12
&bootloader  &trans   &kp HOME      &kp UP    &kp END        &kp INSERT   &kp PG_UP  &kp N7    &kp N8    &kp N9    &trans   &trans
&kp F13      &trans   &kp LEFT      &kp DOWN  &kp RIGHT      &kp ENTER    &kp PG_DN  &kp N4    &kp N5    &kp N6    &trans   &trans
&none        &trans   &kp LC(LEFT)  &kp CAPS  &kp LC(RIGHT)  &kp DEL      &kp PSCRN  &kp N1    &kp N2    &kp N3    &kp N0   &trans
                                    &trans    &trans         &trans       &trans     &trans
                                              &trans         &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        SYM {
            bindings = <
&studio_unlock  &trans     &kp AT    &kp DOLLAR  &kp HASH    &trans      &bt BT_SEL 0  &bt BT_SEL 1  &kp CARET  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&bootloader     &kp GRAVE  &kp LT    &kp EQUAL   &kp GT      &kp GRAVE   &trans        &kp LBKT      &kp UNDER  &kp RBKT      &trans        &trans
&bt BT_CLR      &kp BSLH   &kp LPAR  &kp MINUS   &kp RPAR    &kp PLUS    &kp PRCNT     &kp LBRC      &kp SEMI   &kp RBRC      &kp EXCL      &trans
&out OUT_TOG    &trans     &kp STAR  &kp COLON   &kp SLASH   &trans      &trans        &kp PIPE      &kp TILDE  &kp AMPS      &trans        &none
                                     &trans      &trans      &trans      &trans        &trans
                                                 &trans      &trans      &trans
            >;
        };

        MEDIA {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans      &trans        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans      &trans        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp C_PREV    &kp C_PP    &kp C_NEXT    &trans  &trans
                        &trans  &trans  &trans      &trans  &trans
                                &trans  &trans       &trans
            >;
        };
    };
};
